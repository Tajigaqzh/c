{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}\\build"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin\\cmake.exe",
      "args": [
        "--build",
        "${workspaceFolder}\\build",
        "--config",
        "Debug"
      ],
      "dependsOn": "CMake: configure",
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CMake: run hello",
      "type": "shell",
      "command": "${workspaceFolder}\\build\\Debug\\hello.exe",
      "dependsOn": "CMake: build",
      "problemMatcher": []
    }
  ]
}
